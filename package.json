{
  "name": "keepey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/electron/main/main.cjs",
  "scripts": {
    "api": "node server/api/server.cjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "electron": "node apps/electron/scripts/run-electron.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "web:dev": "vite --config vite.admin.config.ts --host 127.0.0.1 --port 5174 --strictPort",
    "web:build": "tsc -p tsconfig.web-admin.json && vite build --config vite.admin.config.ts",
    "web:preview": "vite preview --config vite.admin.config.ts --host 127.0.0.1 --port 4174",
    "test:ui": "playwright test --config tests/playwright.config.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^42.3.0",
    "expo": "^56.0.8",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.184.0",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "~6.0.3"
  }
}
